{
  "name": "@nixrails/cli",
  "version": "0.1.0",
  "description": "CLI for NixRails scaffolding engine",
  "type": "module",
  "bin": {
    "nixrails": "./bin/nixrails.js"
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run --watch bin/nixrails.ts",
    "test": "bun test",
    "lint": "echo 'Lint not configured yet'",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@types/debug": "^4.1.12",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "debug": "^4.4.3",
    "handlebars": "^4.7.8",
    "inquirer": "^9.2.23",
    "ora": "^7.0.1",
    "supports-color": "^10.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.5.4"
  },
  "engines": {
    "bun": ">=1.3.2",
    "node": ">=24.6.0"
  },
  "packageManager": "bun@1.3.5"
}
