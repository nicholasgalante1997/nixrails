{
  "name": "{{projectScope}}/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "check-types": "turbo check-types"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^{{turboVersion}}",
    "typescript": "^{{typescriptVersion}}"
  },
  "engines": {
    "bun": ">={{bunVersion}}",
    "node": ">={{nodeVersion}}"
  },
  "packageManager": "bun@{{bunVersion}}"
}
