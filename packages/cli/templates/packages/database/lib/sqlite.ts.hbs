{{#if (includes databases "sqlite3")}}
/**
 * SQLite connection utilities
 * Provides database instance and query helpers
 */

import Database from 'better-sqlite3';
import { Logger } from '{{projectScope}}/logger';
import type { DatabaseConfig, ConnectionHealth } from './index.js';

const logger = new Logger('database:sqlite');

export interface SqliteConfig extends DatabaseConfig {
  filename?: string;
  readonly?: boolean;
  fileMustExist?: boolean;
  timeout?: number;
  verbose?: boolean;
}

let db: Database.Database | null = null;

/**
 * Initialize SQLite database
 */
export function initSqlite(config: SqliteConfig = {}): Database.Database {
  if (db) {
    logger.warn('SQLite database already initialized');
    return db;
  }

  const {
    filename = process.env.SQLITE_PATH || './data/{{projectName}}.db',
    readonly = false,
    fileMustExist = false,
    timeout = 5000,
    verbose,
  } = config;

  db = new Database(filename, {
    readonly,
    fileMustExist,
    timeout,
    verbose: verbose ? console.log : undefined,
  });

  // Enable WAL mode for better concurrency
  db.pragma('journal_mode = WAL');

  logger.info(`SQLite database initialized: ${filename}`);

  return db;
}

/**
 * Get SQLite database instance
 */
export function getSqliteDb(): Database.Database {
  if (!db) {
    throw new Error('SQLite database not initialized. Call initSqlite() first.');
  }
  return db;
}

/**
 * Check SQLite connection health
 */
export function checkSqliteHealth(): ConnectionHealth {
  if (!db) {
    return { connected: false, error: 'Database not initialized' };
  }

  try {
    const start = Date.now();
    db.prepare('SELECT 1').get();
    const latency = Date.now() - start;

    return { connected: true, latency };
  } catch (error) {
    const errorMessage = error instanceof Error ? error.message : 'Unknown error';
    return { connected: false, error: errorMessage };
  }
}

/**
 * Close SQLite database
 */
export function closeSqlite(): void {
  if (db) {
    db.close();
    db = null;
    logger.info('SQLite database closed');
  }
}

/**
 * Execute a query that returns rows
 */
export function query<T = any>(sql: string, params?: any[]): T[] {
  const db = getSqliteDb();
  const stmt = db.prepare(sql);
  return stmt.all(...(params || [])) as T[];
}

/**
 * Execute a query that returns a single row
 */
export function queryOne<T = any>(sql: string, params?: any[]): T | undefined {
  const db = getSqliteDb();
  const stmt = db.prepare(sql);
  return stmt.get(...(params || [])) as T | undefined;
}

/**
 * Execute a mutation query (INSERT, UPDATE, DELETE)
 */
export function execute(sql: string, params?: any[]): Database.RunResult {
  const db = getSqliteDb();
  const stmt = db.prepare(sql);
  return stmt.run(...(params || []));
}
{{/if}}
