/**
 * Database package
 * Provides database connection utilities and management
 */

{{#if (includes databases "postgres")}}
export * from './postgres.js';
{{/if}}
{{#if (includes databases "neo4j")}}
export * from './neo4j.js';
{{/if}}
{{#if (includes databases "sqlite3")}}
export * from './sqlite.js';
{{/if}}

export interface DatabaseConfig {
  host?: string;
  port?: number;
  database?: string;
  user?: string;
  password?: string;
  uri?: string;
}

export interface ConnectionHealth {
  connected: boolean;
  latency?: number;
  error?: string;
}
