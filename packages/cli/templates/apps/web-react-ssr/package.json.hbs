{
  "name": "{{projectScope}}/web",
  "version": "0.0.0",
  "private": true,
  "description": "React SSR web application",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --hot src/dev.ts",
    "build": "bun run src/build/browser.ts",
    "check-types": "tsc -p ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "{{projectScope}}/configs": "workspace:*",
    "{{projectScope}}/types": "workspace:*",
    "{{projectScope}}/utils": "workspace:*",
    "{{projectScope}}/logger": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^{{typescriptVersion}}"
  }
}
