# Web application service for {{projectName}}

services:
  {{projectName}}-web:
    image: {{projectName}}-web:latest
    container_name: {{projectName}}-web
    build:
      context: .
      dockerfile: Dockerfile.web
      target: runtime
    environment:
      - PORT=3000
      - NODE_ENV=production
    ports:
      - "3000:3000"
    {{#if databases}}
    depends_on:
      {{#if (includes databases "postgres")}}
      postgres:
        condition: service_healthy
        restart: true
      {{/if}}
      {{#if (includes databases "neo4j")}}
      neo4j:
        condition: service_healthy
        restart: true
      {{/if}}
    {{/if}}
    env_file:
      - ./apps/web/.env
    networks:
      - {{projectName}}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "bun", "run", "-e", "await fetch('http://localhost:3000').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"]
      interval: 30s
      timeout: 3s
      retries: 3
      start_period: 40s

networks:
  {{projectName}}:
    external: true
